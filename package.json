{
  "name": "plan-your-meals",
  "version": "0.2.18",
  "description": "",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "front": "npm run dev -w @plan-your-meals/front",
    "build": "npm run build --workspaces",
    "build:prod": "npm run build -w @plan-your-meals/front -- --mode production",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "bootstrap": "npm install --workspaces",
    "deploy:dev": "firebase deploy --project dev",
    "deploy:prod": "npm run build:prod && firebase deploy --project prod"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbrunois/plan-your-meals.git"
  },
  "author": "gbrunois",
  "bugs": {
    "url": "https://github.com/gbrunois/plan-your-meals/issues"
  },
  "homepage": "https://github.com/gbrunois/plan-your-meals#readme"
}
