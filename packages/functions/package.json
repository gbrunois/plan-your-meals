{
  "name": "@plan-your-meals/functions",
  "description": "whats for dinner firebase functions",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "tslint --project tsconfig.json",
    "prebuild": "rm -rf lib",
    "build": "tsc",
    "postbuild": "cpy '**/*.html' '../lib/src'  --parents --cwd=src",
    "test": "jest --config ./jest.conf.js",
    "integration": "NODE_OPTIONS=--require=./patch-node-builtin-prefix.js jest --config ./jest.conf.integration.js --runInBand --detectOpenHandles",
    "tdd": "jest --config ./jest.conf.js --watch",
    "serve": "npm run build && npx firebase-tools serve --only functions",
    "shell": "npm run build && npx firebase-tools functions:shell",
    "start": "npm run shell",
    "serve:debug": "npm run build && npx firebase-tools emulators:start emulators:start --only functions --inspect-functions",
    "predeploy": "npm run build",
    "deploy": "npx firebase-tools deploy --only functions",
    "logs": "npx firebase-tools functions:log",
    "prettier": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "main": "lib/src/index.js",
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "axios": "^0.33.0",
    "cors": "^2.8.5",
    "dotenv": "^8.6.0",
    "express": "^5.2.1",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "mustache": "^4.2.0",
    "nodemailer": "^6.6.5"
  },
  "devDependencies": {
    "@types/aws-sdk": "^2.7.4",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.8",
    "@types/jest": "^24.9.1",
    "@types/lodash": "^4.14.175",
    "@types/morgan": "^1.9.3",
    "@types/mustache": "^4.1.2",
    "@types/node": "^18.19.130",
    "@types/nodemailer": "^6.4.4",
    "babel-jest": "^24.9.0",
    "cpy-cli": "^3.1.1",
    "jest": "^30.5.1",
    "node-fetch": "^2.7.0",
    "prettier": "^1.19.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^8.10.2",
    "tslint": "^5.20.1",
    "typescript": "^5.3.0"
  }
}
