{
  "name": "@plan-your-meals/functions",
  "description": "whats for dinner firebase functions",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "eslint .",
    "prebuild": "rm -rf lib",
    "build": "tsc",
    "postbuild": "cpy '**/*.html' '../lib/src'  --parents --cwd=src",
    "test": "jest --config ./jest.conf.js",
    "integration": "jest --config ./jest.conf.integration.js --runInBand --detectOpenHandles",
    "tdd": "jest --config ./jest.conf.js --watch",
    "serve": "npm run build && npx firebase-tools serve --only functions",
    "shell": "npm run build && npx firebase-tools functions:shell",
    "start": "npm run shell",
    "serve:debug": "npm run build && npx firebase-tools emulators:start emulators:start --only functions --inspect-functions",
    "predeploy": "npm run build",
    "deploy": "npx firebase-tools deploy --only functions",
    "logs": "npx firebase-tools functions:log",
    "prettier": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "main": "lib/src/index.js",
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "axios": "^0.34.0",
    "cors": "^2.8.5",
    "dotenv": "^8.6.0",
    "express": "^4.22.1",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.2.5",
    "lodash": "^4.17.21",
    "morgan": "^1.12.1",
    "mustache": "^4.2.0",
    "nodemailer": "^10.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.8",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.175",
    "@types/morgan": "^1.9.3",
    "@types/mustache": "^4.1.2",
    "@types/node": "^18.19.130",
    "@types/nodemailer": "^6.4.4",
    "cpy-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.72.1"
  }
}
