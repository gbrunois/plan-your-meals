# Template for the functions' environment files. None of these files should
# ever be committed (see .gitignore) — this repo is public, so no project ID,
# API key or service account secret must ever be hardcoded in source.
#
# Firebase CLI automatically loads a project-scoped file when deploying or
# running the emulator against a given project/alias (aliases come from your
# local, untracked .firebaserc — see .firebaserc.example):
#   .env.<alias-or-project-id>   (e.g. .env.dev, .env.prod) -> loaded for that target only
#   .env                                                    -> loaded in all cases (shared defaults)
# See: https://firebase.google.com/docs/functions/config-env
#
# `dotenv.config()` (used directly by config-service.ts and local integration
# tests, outside of firebase-tools) only reads the plain `.env` file, so keep
# it pointed at the project you want local scripts/tests to run against.
#
# Copy this file to .env.dev / .env.prod and fill in the service account
# credentials from that project's Firebase console > Project settings >
# Service accounts > Generate new private key.
# NEVER reuse another environment's private key.
SA_API_KEY=
SA_PROJECT_ID=
SA_CLIENT_EMAIL=
SA_PRIVATE_KEY=
SA_DATABASE_URL=

# Application configuration
APP_NAME="Plan Your Meals"
APP_URL="http://localhost:3000"
# Comma-separated list of allowed CORS origins (front dev server + deployed hosting URL)
CORS_ORIGIN="http://localhost:5173"

# Gmail configuration
GMAIL_USER=
GMAIL_PASSWORD=
