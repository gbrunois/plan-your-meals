# Template for the front's environment files.
# Vite loads these automatically based on the command:
#   npm run front / vite            -> .env.development
#   npm run build / vite build      -> .env.production
# Copy this file to .env.development or .env.production and fill in the
# values from the target Firebase project's console (Project settings >
# General > Your apps > SDK setup and configuration).
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_DATABASE_URL=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_CLOUD_FUNCTIONS_URL=
VITE_APP_ID=
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs,
# for the same project. Used for Google sign-in via Google Identity Services
# (see auth.service.ts#signInWithGoogle).
VITE_GOOGLE_OAUTH_CLIENT_ID=
