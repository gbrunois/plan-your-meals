{
  "name": "@plan-your-meals/front",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix --max-warnings=50",
    "test": "vitest run",
    "prettier": "prettier --write ./src/**/*.ts ./src/**/*.vue",
    "deploy:rules": "firebase deploy --only firestore:rules --project dev",
    "predeploy:web": "npm run build -- --mode development",
    "deploy:web": "firebase deploy --only hosting --project dev"
  },
  "dependencies": {
    "@mdi/font": "^4.9.95",
    "axios": "^1.20.0",
    "dayjs": "^1.10.7",
    "firebase": "^12.19.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.44",
    "vue-router": "^4.2.0",
    "vuetify": "^3.5.0",
    "vuex": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.5.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "postcss": "^8.4.33",
    "prettier": "^3.8.3",
    "sass": "^1.107.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vuetify": "^2.0.0",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  }
}
