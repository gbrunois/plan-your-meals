{
  "name": "@plan-your-meals/front",
  "version": "0.2.19",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --max-warnings=50",
    "test": "vitest run",
    "prettier": "prettier --write ./src/**/*.ts ./src/**/*.vue",
    "deploy:rules": "firebase deploy --only firestore:rules --project dev",
    "predeploy:web": "npm run build -- --mode development",
    "deploy:web": "firebase deploy --only hosting --project dev"
  },
  "dependencies": {
    "@mdi/font": "^4.9.95",
    "axios": "^1.18.0",
    "dayjs": "^1.10.7",
    "firebase": "^10.0.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vuetify": "^3.5.0",
    "vuex": "^4.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.5.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^9.33.0",
    "postcss": "^8.4.33",
    "prettier": "^3.8.3",
    "sass": "^1.70.0",
    "typescript": "^5.3.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vuetify": "^2.0.0",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.0.0"
  }
}
